{
  "manifest_version": 3,
  "name": "Phishing Detector",
  "version": "2.1",
  "description": "Detects phishing sites based on URL input",
  "permissions": ["activeTab", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "download.png"
    }
  },
  "icons": {
    "128": "download.png"
  },
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
